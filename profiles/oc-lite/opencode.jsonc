{
  "$schema": "https://opencode.ai/config.json",
  "experimental": { "subagent_depth": 1 },
  "default_agent": "worker",
  "compaction": {
    "auto": true,
    "buffer": 25600
  },
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    }
  },
  "plugins": ["./plugins/oc-lite-v2"],
  "permissions": [
    { "action": "harness_state", "resource": "*", "effect": "deny" },
    { "action": "investigate", "resource": "*", "effect": "deny" }
  ]
}
