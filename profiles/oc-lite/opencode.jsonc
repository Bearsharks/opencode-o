{
  "$schema": "https://opencode.ai/config.json",
  "experimental": { "subagent_depth": 1 },
  "default_agent": "worker",
  "compaction": {
    "auto": true,
    "buffer": 25600
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-6-sol": {
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          }
        },
        "gpt-6-sol-fast": {
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          }
        },
        "gpt-6.1-sol": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        },
        "gpt-6.1-sol-fast": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        },
        "gpt-6-astra": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        },
        "gpt-6-astra-fast": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        }
      }
    }
  },
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    }
  },
  "mcp": {
    "servers": {
      "roblox_studio": {
        "type": "local",
        "command": ["/Applications/RobloxStudio.app/Contents/MacOS/StudioMCP"],
        "protocol": "legacy"
      }
    }
  },
  "plugins": ["./plugins/oc-lite-v2"],
  "permissions": [
    { "action": "harness_state", "resource": "*", "effect": "deny" },
    { "action": "investigate", "resource": "*", "effect": "deny" },
    { "action": "roblox_studio_start_stop_play", "resource": "*", "effect": "deny" },
    { "action": "roblox_studio_multi_edit", "resource": "*", "effect": "deny" },
    { "action": "roblox_studio_character_navigation", "resource": "*", "effect": "deny" },
    { "action": "roblox_studio_http_get", "resource": "*", "effect": "deny" },
    { "action": "roblox_studio_subagent", "resource": "*", "effect": "deny" }
  ]
}
