{
  "$schema": "https://opencode.ai/config.json",
  "experimental": { "subagent_depth": 1 },
  "default_agent": "worker",
  "compaction": {
    "auto": true,
    "buffer": 25600
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-6-sol": {
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          }
        },
        "gpt-6-sol-fast": {
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          }
        },
        "gpt-6.1-sol": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        },
        "gpt-6.1-sol-fast": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        },
        "gpt-6-astra": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        },
        "gpt-6-astra-fast": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        }
      }
    }
  },
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    }
  },
  "plugins": ["./plugins/oc-lite-v2"],
  "permissions": [
    { "action": "harness_state", "resource": "*", "effect": "deny" },
    { "action": "investigate", "resource": "*", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "tldraw-dotcom": {
        "type": "remote",
        "url": "https://www.tldraw.com/api/app/mcp"
      }
    }
  }
}
